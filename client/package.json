{
  "name": "trazabilidad-electron-client",
  "version": "1.0.0",
  "description": "Cliente nativo Electron para verificación de productos en línea de producción",
  "main": "dist/electron-main.js",
  "scripts": {
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.trazabilidad.client",
    "productName": "Sistema Trazabilidad Industrial",
    "directories": {
      "output": "internal/release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [
    "electron",
    "trazabilidad",
    "industrial",
    "tfg"
  ],
  "author": "Yeray Navascués Trincado",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
